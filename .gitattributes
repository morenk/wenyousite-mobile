# Keep cross-platform source and generated contracts deterministic without
# renormalizing every extensionless or platform-owned file in the repository.
*.dart text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.lock text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.plist text eol=lf
*.xcconfig text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.sh text eol=lf

# OpenAPI Generator writes this manifest with CRLF on the Windows-only mobile
# development environment.
packages/wenyou_api/.openapi-generator/FILES text eol=crlf

*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ttf binary
*.otf binary
*.jks binary
*.keystore binary
